# Required for Step 1 (TrustMRR revenue layer)
TRUSTMRR_API_KEY=
TRUSTMRR_BASE_URL=https://trustmrr.com/api/v1

# Optional but recommended (raises GitHub rate limit from 60 to 5000 req/h)
GITHUB_TOKEN=

# Required for Step 2 (Product Hunt)
PRODUCTHUNT_TOKEN=

# Optional Reddit OAuth (Step 4). If absent, public .json endpoints are used.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=appbuilder-research/0.1
